# ~/.ssh/rc — run by sshd on every login (linked by setup.sh).
# Point a fixed path at this login's forwarded agent so tmux panes started
# by an earlier login keep working after a reconnect (see tmux_set.conf).
if [ -n "$SSH_AUTH_SOCK" ] && [ "$SSH_AUTH_SOCK" != "$HOME/.ssh/ssh_auth_sock" ]; then
  ln -sf "$SSH_AUTH_SOCK" "$HOME/.ssh/ssh_auth_sock"
fi

# With ~/.ssh/rc present sshd no longer runs xauth for X11 forwarding;
# do it here (snippet from sshd(8)).
if read proto cookie && [ -n "$DISPLAY" ]; then
  if [ "$(echo "$DISPLAY" | cut -c1-10)" = 'localhost:' ]; then
    echo add "unix:$(echo "$DISPLAY" | cut -c11-)" "$proto" "$cookie"
  else
    echo add "$DISPLAY" "$proto" "$cookie"
  fi | xauth -q -
fi
