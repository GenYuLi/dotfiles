% etched, orbstack, vm

# 開 VM（OrbStack 的 arm64 AlmaLinux 9，repo 在 ~/sw）
orb start dev

# 停止 VM（記憶體會還給 Mac，資料保留）
orb stop dev

# VM 狀態
orb list

# ssh 進 VM（OrbStack 自動轉發 Mac 的 ssh-agent，可以 git push/pull）
ssh sw-dev

# 不經 ssh 直接進 VM
orb -m dev

# VSCode Remote-SSH 開 VM 裡的 sw repo
code --remote ssh-remote+sw-dev /home/withers/sw

# VM 磁碟和記憶體用量
orb -m dev bash -c 'df -h / | tail -1; free -g | head -2'

# 改 VM 記憶體上限（MiB；OrbStack 會彈性歸還沒用到的）
orb config set memory_mib <memory_mib>

# 允許 Rosetta debugserver 使用 ptrace（暫時，VM 重開後恢復）
orb -m dev sudo sysctl -w kernel.yama.ptrace_scope=0

# 重新跑 Francis 的 setup script（可重跑，做過的步驟會跳過；--local 裝 x86 loader 和 L10 patch）
ssh sw-dev 'bash /mnt/mac/Users/withers/arm64-vm/setup_vm_noghcr.sh --local'

# VM 裡拉 master：六個 patch 檔是 skip-worktree，`git pull` 會拒絕；這個 wrapper 會 stash → pull → 重套 patch
git vmpull

$ memory_mib: printf '17408\n12288\n'

% etched, debug, rosetta

# 用 Rosetta debugserver 啟動 x86 程式，等待 debugger 連入（需先放寬 ptrace_scope）
ROSETTA_DEBUGSERVER_PORT=<port> <program>

# gdb 連到 Rosetta debugserver
gdb <program> -ex "target remote localhost:<port>"

# lldb 連到 Rosetta debugserver
lldb <program> -o "gdb-remote <port>"

$ port: echo 1234

% etched, bazel

# 計時執行（bash/zsh 通用，印出 exit code 和秒數）
t() { local s=$SECONDS; "$@" 2>&1 | tail -5; local rc=${PIPESTATUS[0]:-${pipestatus[1]}}; echo ">>> exit=$rc $((SECONDS-s))s  :: $*"; }

# build ARC 韌體
bazel build -c opt --config arc //fw/app/sohu/<app>:<app>.all

# 跑韌體：VCS 模擬器 / emulator / chipsim（VM 上 chipsim 是原生 arm64；~/.bazelrc 已設 CcConfigureMakeRule=local）
bazel run //fw/app/sohu/<app>:<run_target>

# chipsim 改用 x86_64 版在 Rosetta 下跑（跟 CI/strata 同一份 binary、共用 remote cache；模擬比原生慢）
bazel run --platforms=//bzl/platforms:linux_x86_64_glibc234 //fw/app/sohu/<app>:run_chip_sim

# 跑 test（強制實際執行，不用快取結果）
bazel test --nocache_test_results <target>

# 遠端 build（RBE；只下載你點名的產物。VM 預設 --config=developer）
bazel build --remote_download_minimal <target>

# 與 RBE 賽跑：每個 action 同時在遠端和 VM 跑，先完成的贏；RBE 的結果會填進 disk cache
bazel build --config=race <target>

# 完全本機 x86_64 build（Rosetta；要先跑過 setup --local）
bazel build --config=local <target>

# 本機跑 x86_64 產物（--platforms 要蓋掉 user.bazelrc 的 run --platforms=@platforms//host）
bazel run --config=local --platforms=//bzl/platforms:linux_x86_64_glibc234 <target> -- <args>

# 印出 BuildBuddy 的產物下載網址（上一次 build 的 /tmp/bep.json）
~/bin/bb-url.nu

# 產生 compile_commands.json（給 clangd）
bazel-compile-commands <scope>

$ app: ls fw/app/sohu
$ run_target: printf 'run_chip_sim\nrun\nrun_emu\n'
$ scope: printf '//fw/...\n//host/...\n//...\n'
$ target: printf '//host/system_test:L10_test_package_image_tarball\n//fw/app/sohu/simple_example:simple_example.all\n'

% etched, lint

# lint 有改動的檔案
uv run lint

# clang-tidy（C++ 獨立的 CI 關卡）
uv run scripts/run_clang_tidy.py origin/master

# Rust fmt + clippy 檢查
uv run lint --rust --check

% etched, l10, rack

# 開到 RMS 的 tun0 隧道（192.168.96.0/24 經由 VM；要先在 ~/.ssh/config 有 <rms>）
~/bin/tunnel_up.fish <rms>

# 關掉隧道（換 rack 之前）
~/bin/tunnel_up.fish down

# 在 VM 用 podman 對 rack 跑 L10（-b 先 build 並載入 image；在 ~/sw 裡執行）
~/bin/run_l10.nu <server> <rack> -t <suite> -b

$ rms: printf 'rms1\n'
$ suite: printf 'L10_FAT\nL10_SFT\nL10_RIN\n'

% etched, strata

# 連到 strata（工作目錄 /project/sw/withers，repo 在 /project/sw/withers/sw）
ssh <host>

# VSCode Remote-SSH 開 strata 上的 sw repo
code --remote ssh-remote+<host> /project/sw/withers/sw

$ host: printf 'strata5\nstrata4\n'
